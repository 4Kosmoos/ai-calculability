FROM python:3.12-slim
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY robot_agent ./robot_agent

RUN useradd --no-create-home --uid 1000 agent && chown -R agent /app
USER agent

ENV GRID_URL=http://grid-api:8000
ENTRYPOINT ["python", "-m", "robot_agent"]
CMD ["bfs"]